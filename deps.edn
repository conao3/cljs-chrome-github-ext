{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  org.clojure/clojurescript {:mvn/version "1.12.145"}
  thheller/shadow-cljs {:mvn/version "3.5.8"}
  reagent/reagent {:mvn/version "2.0.1"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                io.github.clojure/tools.build {:mvn/version "0.10.14"}}}
  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build
   :jvm-opts ["-Dclojure.compiler.direct-linking=true"]}}}
